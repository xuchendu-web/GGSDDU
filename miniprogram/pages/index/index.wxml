<view class="page cover">
  <view class="eyebrow">INVESTOR REFLECTION</view>
  <view class="title">投资反思卡</view>
  <view class="subtitle">随机读一页，让决定慢下来</view>

  <view class="book {{opening ? 'opening' : ''}}" bindtap="draw">
    <view class="book-line"></view>
    <view class="book-name">想好一个投资问题</view>
    <view class="book-hint">无需输入，也不会采集</view>
  </view>

  <view class="themes">
    <view class="theme-label">也可以从一个时刻开始</view>
    <view class="theme-row">
      <button class="theme" data-theme="preopen" catchtap="draw">开盘前</button>
      <button class="theme" data-theme="close" catchtap="draw">收盘后</button>
      <button class="theme" data-theme="weekend" catchtap="draw">周末复盘</button>
    </view>
  </view>

  <button class="primary action" loading="{{loading}}" bindtap="draw">翻开一页</button>
  <view class="links">
    <text bindtap="goLibrary">收藏与最近</text>
    <text bindtap="goAbout">关于与风险提示</text>
  </view>
  <view class="risk-note">教育性反思内容，不构成投资建议。请依据自身情况独立判断。</view>
</view>
