<view class="page">
  <view class="tabs">
    <view class="{{tab === 'favorites' ? 'active' : ''}}" data-tab="favorites" bindtap="switchTab">收藏</view>
    <view class="{{tab === 'recent' ? 'active' : ''}}" data-tab="recent" bindtap="switchTab">最近</view>
  </view>
  <view wx:if="{{items.length}}">
    <view class="item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openCard">
      <view class="item-title">{{item.title}}</view>
      <view class="item-answer">{{item.shortAnswer}}</view>
      <view class="item-question">{{item.reflectionQuestion}}</view>
    </view>
  </view>
  <view wx:else class="empty">{{tab === 'favorites' ? '还没有收藏' : '还没有翻阅记录'}}</view>
</view>
