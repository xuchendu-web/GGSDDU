<view class="page result-page">
  <view wx:if="{{loading}}" class="loading">正在翻开这一页…</view>
  <block wx:elif="{{card}}">
    <view class="eyebrow">{{shared ? '朋友送来的这一页' : 'YOUR REFLECTION'}}</view>
    <view class="card">
      <view class="card-number">{{card.id}}</view>
      <view class="card-title">{{card.title}}</view>
      <view class="answer">{{card.shortAnswer}}</view>
      <view class="divider"></view>
      <view class="question-label">留给自己的问题</view>
      <view class="question">{{card.reflectionQuestion}}</view>
      <view class="boundary">{{card.boundary}}</view>
    </view>
    <view class="actions">
      <button class="secondary" bindtap="favorite">{{favoriteText}}</button>
      <button class="primary" open-type="share">送给朋友</button>
    </view>
    <button wx:if="{{shared}}" class="next" bindtap="drawOwn">翻自己的第一页</button>
    <view class="source-note">{{source === 'local' ? '本地审核内容 · 弱网可用' : '云端审核内容'}}</view>
  </block>
  <view wx:else class="empty">
    <view>这一页暂时无法打开</view>
    <button class="primary" bindtap="backHome">返回首页</button>
  </view>
</view>
